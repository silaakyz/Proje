# Database: any PostgreSQL 15+ with the pgvector extension available. The quickest local setup is
# `docker compose up -d db` (docker-compose.yml, pgvector/pgvector:pg16), which uses POSTGRES_PASSWORD below.
# Percent-encode special characters in the password inside the URLs (@ → %40, # → %23, ı → %C4%B1 …).
# Never commit the real values: .env is git-ignored.
POSTGRES_PASSWORD=
# Runtime (src/db, postgres-js). The role must own the tables (it runs the migrations) and be a member of
# `authenticated` (scripts/db/bootstrap.sql grants that to the role that runs it).
DATABASE_URL=postgresql://eip:<password>@localhost:5432/eip
# Migrations / preflight (pg). Optional: falls back to DATABASE_URL. Set it only when migrations must use a
# different connection (e.g. directly to the server while the app goes through PgBouncer). For a remote server
# add ?sslmode=require to both URLs.
DIRECT_URL=
# Drizzle runtime pool size per server instance
DB_POOL_MAX=5

# AI — the plan proposals, Asistan and Raporlar. Two providers; AI_PROVIDER picks one (unset: whichever key is set).
#   google    — Gemini, has a FREE tier: create a key at https://aistudio.google.com → "Get API key".
#               Free-tier prompts may be used by Google to improve its products; the app sends no personal data.
#   anthropic — Claude (paid): https://console.anthropic.com → API Keys.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Model ids (optional; defaults per provider: Gemini gemini-3.8-flash / assistant gemini-3.5-flash-lite,
# Claude claude-sonnet-5-5 / impact narrative claude-opus-5-5).
AI_MODEL_EVENT_BUILDER=
AI_MODEL_IMPACT_NARRATIVE=
AI_MODEL_ASSISTANT=
# Own-data tables: column-meaning suggestion and interpretation (default gemini-3.8-flash / claude-sonnet-5-5)
AI_MODEL_DATA_ANALYSIS=
# Tried once when the main model fails (busy, quota, not available for the key, cut-off answer).
# Default: gemini-3.5-flash-lite / claude-haiku-5-5
AI_MODEL_FALLBACK=
# Gemini 3 thinking level for plan generation: minimal | low | medium | high (default low)
AI_THINKING_LEVEL=
# NLP worker callback
NLP_WEBHOOK_SECRET=

# External data sources (event → "Veri Kaynakları"): credentials of the services the metrics are pulled from.
# Air quality (Open-Meteo) and the press search (GDELT, Google News) need no key. Leave a key empty to keep
# that source off. Which account / campaign / page to read is set per event in the app, never here.
#   Brevo: app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
#   Google Analytics 4: Google Cloud → service account → JSON key; enable "Google Analytics Data API" and add the
#   account's e-mail to the GA4 property as Viewer. Path to the JSON file on this computer (keep it outside the repo):
GA4_SERVICE_ACCOUNT_FILE=
#   Meta (Instagram business account + Facebook page): a long-lived Page access token with instagram_basic,
#   instagram_manage_insights, pages_read_engagement, read_insights. Graph API version (optional, default v25.0).
META_ACCESS_TOKEN=
META_GRAPH_VERSION=
#   YouTube Data API v3: Google Cloud → APIs & Services → Credentials → API key
YOUTUBE_API_KEY=
# Automatic pulls while the app runs: how often is chosen per source on the Veri Kaynakları page.
# 0 = automatic pulls off (then use npm run connectors:pull); any other value = on.
CONNECTORS_SYNC_INTERVAL_MINUTES=60

# Feature flags
FEATURE_PAID_TICKETS=false

# Demo account for presentations ("Demo Olarak Devam Et" on the sign-in page; npm run demo:seed creates it).
# Leave DEMO_EMAIL/DEMO_PASSWORD empty to hide the demo button. The password stays on the server.
# Accounts and e-mail
SIGNUP_MODE=open
EMAIL_FROM=
APP_URL=
