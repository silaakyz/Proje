# Production settings for docker-compose.prod.yml — on the server: cp deploy/env.production.example .env.production, then fill in.
# NEVER commit .env.production. Passwords appear in connection URLs: generate URL-safe ones with
#   openssl rand -hex 32

# Address and HTTPS certificate (the domain's DNS must point to this server)
DOMAIN=etkinlik.ornek.com.tr
ACME_EMAIL=bilgi@ornek.com.tr

# Database: superuser for migrations, separate least-privilege role for the application
POSTGRES_USER=eip_owner
POSTGRES_DB=eip
POSTGRES_PASSWORD=
APP_DB_USER=eip_app
APP_DB_PASSWORD=
DB_POOL_MAX=10

# Backups (server time)
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# AI — one provider. For real organization data use a paid plan (Gemini's free tier may use prompts to improve Google products).
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_EVENT_BUILDER=
AI_MODEL_IMPACT_NARRATIVE=
AI_MODEL_ASSISTANT=
AI_MODEL_DATA_ANALYSIS=
AI_MODEL_FALLBACK=
AI_THINKING_LEVEL=

# External data sources (optional; empty = that source shows "key missing")
BREVO_API_KEY=
# put the JSON key in ./secrets/ga4.json on the server, then:
GA4_SERVICE_ACCOUNT_FILE=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=
YOUTUBE_API_KEY=
CONNECTORS_SYNC_INTERVAL_MINUTES=60

NLP_WEBHOOK_SECRET=

# Demo account: leave unset in production (the "Demo Olarak Devam Et" button stays hidden)
