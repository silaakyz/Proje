{
  "name": "live-event-os",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run -c vitest.live.config.ts",
    "verify": "npm run typecheck && npm run test && npm run drizzle:check && npm run test:db",
    "test:db": "vitest run -c vitest.db.config.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:check": "drizzle-kit check",
    "drizzle:migrate": "node scripts/db/migrate.mjs",
    "db:preflight": "node scripts/db/preflight.mjs",
    "db:app-role": "node scripts/db/app-role.mjs",
    "drizzle:migrate:kit": "drizzle-kit migrate",
    "db:up": "docker compose up -d db",
    "auth:set-password": "tsx --conditions=react-server scripts/auth/set-password.ts",
    "admin:create": "tsx --conditions=react-server scripts/auth/create-admin.ts",
    "org:delete": "tsx --conditions=react-server scripts/db/delete-organization.ts",
    "connectors:pull": "tsx --conditions=react-server scripts/connectors/pull.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/react": "^4.0.146",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@tanstack/react-query": "^5.83.0",
    "ai": "^7.0.142",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "jsqr": "^1.4.0",
    "next": "^16.4.2",
    "pdfkit": "0.20.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
